RewriteEngine On
Options -MultiViews
DirectoryIndex index.html

# Return the React-based custom 404 document with an actual HTTP 404 status.
# 404.html is created by the frontend post-build SEO generation script.
ErrorDocument 404 /404.html

# BEGIN cPanel-generated php ini directives - retain these hosting settings.
<IfModule php8_module>
    php_value error_log "/home/nestroamholidays/logs/php.error.log"
    php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
    php_value error_log "/home/nestroamholidays/logs/php.error.log"
    php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives

# Canonical host: HTTPS + non-www.
RewriteCond %{HTTP_HOST} !^nestroamholidays\.com$ [NC]
RewriteRule ^ https://nestroamholidays.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-SSL} !on [NC]
RewriteRule ^ https://nestroamholidays.com%{REQUEST_URI} [R=301,L]

# Normalize trailing slashes on known content routes to their canonical URLs.
RewriteRule ^(destinations|tour-packages)/$ https://nestroamholidays.com/$1 [R=301,L,NC]
RewriteRule ^(destinations|tour-packages)/(manali|shimla|kasol|spiti)/$ https://nestroamholidays.com/$1/$2 [R=301,L,NC]
RewriteRule ^(adventure|about|contact)/$ https://nestroamholidays.com/$1 [R=301,L,NC]

# Legacy routes: permanently redirect to the current lowercase URLs.
RewriteRule ^AdventurePage/?$ https://nestroamholidays.com/adventure [R=301,L,NC]
RewriteRule ^adventures/?$ https://nestroamholidays.com/adventure [R=301,L,NC]
RewriteRule ^Contact/?$ https://nestroamholidays.com/contact [R=301,L,NC]
RewriteRule ^TourPackagesPage/ManaliPackage/?$ https://nestroamholidays.com/tour-packages/manali [R=301,L,NC]
RewriteRule ^TourPackagesPage/ShimlaPackage/?$ https://nestroamholidays.com/tour-packages/shimla [R=301,L,NC]
RewriteRule ^TourPackagesPage/KasolPackage/?$ https://nestroamholidays.com/tour-packages/kasol [R=301,L,NC]
RewriteRule ^TourPackagesPage/SpitiPackage/?$ https://nestroamholidays.com/tour-packages/spiti [R=301,L,NC]
RewriteRule ^TourPackagesPage/?$ https://nestroamholidays.com/tour-packages [R=301,L,NC]

# Serve route-specific HTML documents generated by the Vite SEO build.
# These keep the clean React Router URL while returning route-specific metadata.
RewriteRule ^destinations/?$ destinations.html [L]
RewriteRule ^destinations/(manali|shimla|kasol|spiti)/?$ destinations/$1.html [L,NC]
RewriteRule ^tour-packages/?$ tour-packages.html [L]
RewriteRule ^tour-packages/(manali|shimla|kasol|spiti)/?$ tour-packages/$1.html [L,NC]
RewriteRule ^(adventure|about|contact)/?$ $1.html [L,NC]

# Existing files (assets, generated HTML, robots.txt, etc.) are served normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Do not add a catch-all rewrite to index.html here.
# Unmatched direct requests must reach Apache's 404 handler above. The ErrorDocument
# serves /404.html, where React Router renders the supplied NotFound component.
