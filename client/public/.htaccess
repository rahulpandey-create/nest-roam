Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve real files and directories directly. Let React Router handle application routes,
# including /blogs/:slug when a visitor refreshes or opens a deep link.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]
